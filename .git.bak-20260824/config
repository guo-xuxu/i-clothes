[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@github.com:guo-xuxu/i-clothes.git
	fetch = +refs/heads/*:refs/remotes/origin/*
