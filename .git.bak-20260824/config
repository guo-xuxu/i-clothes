	merge = refs/heads/main
[branch "feat/springboot-migration"]
	remote = origin
	merge = refs/heads/feat/springboot-migration
[branch "feat/knowledge-graph-rag"]
	remote = origin
	merge = refs/heads/feat/knowledge-graph-rag
